# Local development environment.
#
#   cp .env.example .env
#
# Two consumers read this file:
#   * `etc/dev.sh` exports it before starting the Go API — the binary itself
#     only reads the process environment, never a .env file.
#   * `docker compose` uses it to interpolate ${...} in docker-compose*.yml.
#
# The values below assume the backing services run in Docker (via
# `make dev-services`) and the API runs on the host, hence `localhost` rather
# than the in-network hostnames used by docker-compose.yml.

# --- Datastores -------------------------------------------------------------
# One database per store; all four are created by docker/postgres/init-databases.sh.
POSTGRES_MANAGEMENT_URI=postgres://postgres:postgrespw@localhost:5432/management?sslmode=disable
POSTGRES_SUBJECTS_URI=postgres://postgres:postgrespw@localhost:5432/subjects?sslmode=disable
POSTGRES_JOURNEY_URI=postgres://postgres:postgrespw@localhost:5432/journey?sslmode=disable
RBAC_POSTGRES_URI=postgres://postgres:postgrespw@localhost:5432/rbac?sslmode=disable

REDIS_ADDRESS=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Run schema migrations on boot. Handy in development; every restart re-checks
# them, so set to false if you want faster reloads.
DATABASE_MIGRATE=true

# --- HTTP -------------------------------------------------------------------
HTTP_ADDRESS=:8080

# Base URL stamped into user-facing links (unsubscribe, preference centre,
# click tracking). Point it at the Vite dev server (http://localhost:5173) if
# you want those links to open the hot-reloading console instead.
PUBLIC_URL=http://localhost:8080

# --- Authentication ---------------------------------------------------------
# `basic` logs in with the single email/password pair below. The alternatives
# are `clerk` and a generic JWKS issuer — see internal/config/config.go.
AUTH_DRIVER=basic
AUTH_JWT_SECRET=dev-secret-change-in-production
AUTH_BASIC_EMAIL=admin@localhost
AUTH_BASIC_PASSWORD=admin

# --- Storage ----------------------------------------------------------------
# `local` writes uploads to disk; `s3` needs the STORAGE_S3_* variables.
STORAGE_TYPE=local
STORAGE_LOCAL_UPLOAD_DIRECTORY=./uploads/documents
