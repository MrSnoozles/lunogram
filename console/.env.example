# Console development environment.
#
#   cp console/.env.example console/.env
#
# Only VITE_-prefixed variables reach the browser bundle. The dev server reads
# these; production builds get their runtime config from the API's /config.js.

# Where the Vite dev server proxies /api, /static, /unsubscribe and
# /preferences — i.e. the Go API.
VITE_PROXY_URL=http://localhost:8080

# API base URL used by the axios client. Leave unset to use the relative "/api"
# path, which goes through the proxy above and avoids CORS entirely.
# VITE_API_BASE_URL=/api

# Enterprise-only upstreams; ignored by the open-source build.
# VITE_BACKOFFICE_URL=http://localhost:8081
# VITE_COURIER_URL=http://localhost:8082
# VITE_ENTERPRISE=false
# VITE_CLERK_PUBLISHABLE_KEY=
